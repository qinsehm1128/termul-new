{
  "schemaVersion": 1,
  "revision": 3,
  "channels": [
    {
      "id": "gateway",
      "displayName": "Gateway",
      "provider": "vercelGateway",
      "baseUrl": "https://gateway.example.test/v1",
      "enabled": true,
      "credentialRef": {
        "kind": "keyring",
        "ref": "ai/channel/gateway",
        "hasCredential": true
      },
      "modelIds": ["model-a"]
    }
  ],
  "profiles": [
    {
      "id": "profileA",
      "channelId": "gateway",
      "modelId": "model-a",
      "enabled": true,
      "capabilities": {
        "descriptionAnalysis": true,
        "fxRuntime": false,
        "structuredOutput": true,
        "toolCalling": false
      },
      "maxOutputTokens": 2048,
      "temperature": 0.5
    }
  ],
  "routes": [
    {
      "purpose": "descriptionAnalysis",
      "profileIds": ["profileA"],
      "maxAttempts": 2,
      "timeoutMs": 15000
    },
    {
      "purpose": "fxRuntime",
      "profileIds": ["profileA"],
      "maxAttempts": 1,
      "timeoutMs": 30000
    }
  ]
}
