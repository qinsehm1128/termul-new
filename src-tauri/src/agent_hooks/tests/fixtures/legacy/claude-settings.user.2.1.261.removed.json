{
  "permissions": {
    "allow": [
      "Bash(ls)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo user se-manager-hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "user",
        "hooks": [
          {
            "type": "command",
            "command": "echo user-session-end"
          }
        ]
      }
    ],
    "PreToolUse": [],
    "PostToolUse": [],
    "Notification": [],
    "SubagentStop": [],
    "UserPromptSubmit": [],
    "SessionStart": [],
    "SubagentStart": [],
    "PermissionRequest": [],
    "PostToolUseFailure": []
  },
  "theme": "dark",
  "env": {
    "USER_SETTING": "preserve-me"
  }
}
