{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Termul Manager",
	"version": "0.5.3",
	"identifier": "com.termul-manager.app",
	"build": {
		"beforeDevCommand": "bunx vite --config vite.config.tauri.ts",
		"devUrl": "http://localhost:5180/tauri-index.html",
		"beforeBuildCommand": "bunx vite build --config vite.config.web.ts && bunx vite build --config vite.config.tauri.ts",
		"frontendDist": "../dist-tauri"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"url": "tauri-index.html",
				"title": "Termul Manager",
				"width": 1200,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600,
				"decorations": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": {
					"x": 14,
					"y": 16
				},
				"visible": false,
				"transparent": false,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:* ws://127.0.0.1:* https://api.github.com; worker-src 'self' blob:; img-src 'self' asset: http://asset.localhost data: https://picsum.photos; font-src 'self' data:; media-src 'self' blob:;"
		}
	},
	"plugins": {
		"fs": {
			"requireLiteralLeadingDot": false
		},
		"updater": {
			"active": true,
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3RTAyODJCODI4RUY3MTkKUldRWjk0NkNLeWpndHhFajBGejJHTEtJNFZvSlY1aGVMeDhNRTI2eEVKaitEYmt5RUFoWWlxK0MK",
			"endpoints": [
				"https://github.com/qinsehm1128/termul-new/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"externalBin": [
			"bin/rg"
		],
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"publisher": "qinsehm1128",
		"copyright": "Copyright © 2025 gnoviawan; © 2026 qinsehm1128. MIT licensed.",
		"category": "Productivity",
		"shortDescription": "Termul Manager - Project-aware terminal manager",
		"longDescription": "Termul Manager is a desktop application built with Tauri for enhanced productivity. Organize terminals by project with persistent sessions and snapshots.",
		"windows": {
			"nsis": {
				"displayLanguageSelector": false
			}
		}
	}
}
