{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termul.dev/plugin/v1/action.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "pluginId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "viewId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "viewRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "actionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "kind": {
      "enum": [
        "click",
        "change"
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 8192
        },
        {
          "type": "boolean"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "pluginId",
    "generation",
    "viewId",
    "viewRevision",
    "nodeId",
    "actionId",
    "kind",
    "value"
  ],
  "additionalProperties": false,
  "$comment": "Structural contract only; host validates current tree, control type, actionId, disabled, generation, revision, input maxLength and select membership. Input at most 262144 UTF-8 bytes.",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "click"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": [
              "string",
              "boolean"
            ]
          }
        }
      }
    }
  ]
}
