{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termul.dev/plugin/v1/manifest.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "abi": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "contributes": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "description": {
                "type": "string",
                "minLength": 0,
                "maxLength": 2048
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "configuration": {
          "$ref": "configuration.schema.json"
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "location": {
                "enum": ["panel", "sidebar"]
              },
              "icon": {
                "type": "string",
                "enum": [
                  "puzzle", "calculator", "chart-bar", "terminal", "database", "cloud",
                  "git-branch", "bug", "book-open", "bell", "calendar", "clock",
                  "folder", "globe", "key", "list-checks", "message-square", "package",
                  "play", "rocket", "search", "settings", "shield", "wrench"
                ],
                "$comment": "Must match src/shared/plugin-fixtures/view-icons.json."
              }
            },
            "required": [
              "id",
              "title",
              "location"
            ],
            "additionalProperties": false
          },
          "maxItems": 8,
          "contains": {
            "type": "object",
            "properties": {
              "location": { "const": "sidebar" }
            },
            "required": ["location"]
          },
          "minContains": 0,
          "maxContains": 2
        }
      },
      "required": [
        "commands",
        "configuration",
        "views"
      ],
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "properties": {
        "provides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "maxItems": 32
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "maxItems": 32
        }
      },
      "required": [
        "provides",
        "requires"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "abi",
    "contributes",
    "services"
  ],
  "additionalProperties": false,
  "$comment": "Input is at most 262144 UTF-8 bytes. Runtime validates semver, abi.min <= abi.max, and unique same-kind contribution IDs."
}
