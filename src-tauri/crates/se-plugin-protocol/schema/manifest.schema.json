{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termul.dev/plugin/v1/manifest.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "abi": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "contributes": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "description": {
                "type": "string",
                "minLength": 0,
                "maxLength": 2048
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "configuration": {
          "$ref": "configuration.schema.json"
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "location": {
                "enum": [
                  "panel",
                  "sidebar"
                ]
              },
              "icon": {
                "type": "string",
                "enum": [
                  "puzzle",
                  "calculator",
                  "chart-bar",
                  "terminal",
                  "database",
                  "cloud",
                  "git-branch",
                  "bug",
                  "book-open",
                  "bell",
                  "calendar",
                  "clock",
                  "folder",
                  "globe",
                  "key",
                  "list-checks",
                  "message-square",
                  "package",
                  "play",
                  "rocket",
                  "search",
                  "settings",
                  "shield",
                  "wrench"
                ],
                "$comment": "Must match src/shared/plugin-fixtures/view-icons.json."
              }
            },
            "required": [
              "id",
              "title",
              "location"
            ],
            "additionalProperties": false
          },
          "maxItems": 8,
          "contains": {
            "type": "object",
            "properties": {
              "location": {
                "const": "sidebar"
              }
            },
            "required": [
              "location"
            ]
          },
          "minContains": 0,
          "maxContains": 2
        },
        "eventSubscriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/localId"
              },
              "topic": {
                "enum": [
                  "project.activeChanged",
                  "terminal.created",
                  "terminal.closed",
                  "terminal.activeChanged",
                  "agent.session.stateChanged"
                ]
              },
              "scope": {
                "$ref": "#/$defs/scope"
              }
            },
            "required": [
              "id",
              "topic",
              "scope"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "topic": {
                      "const": "project.activeChanged"
                    }
                  },
                  "required": [
                    "topic"
                  ]
                },
                "then": {
                  "properties": {
                    "scope": {
                      "const": "window"
                    }
                  }
                }
              }
            ]
          },
          "maxItems": 16,
          "default": []
        },
        "menus": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/localId"
              },
              "location": {
                "enum": [
                  "terminal.tab",
                  "terminal.context",
                  "project.context",
                  "agentSession.context"
                ]
              },
              "commandId": {
                "$ref": "#/$defs/localId"
              },
              "order": {
                "$ref": "#/$defs/order"
              },
              "when": {
                "$ref": "#/$defs/when"
              }
            },
            "required": [
              "id",
              "location",
              "commandId"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "default": []
        },
        "keybindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/localId"
              },
              "commandId": {
                "$ref": "#/$defs/localId"
              },
              "key": {
                "$ref": "#/$defs/key"
              },
              "mac": {
                "$ref": "#/$defs/key"
              },
              "when": {
                "allOf": [
                  {
                    "$ref": "#/$defs/when"
                  },
                  {
                    "properties": {
                      "textInput.focused": {
                        "const": false
                      },
                      "terminal.focused": {
                        "const": false
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "id",
              "commandId",
              "key"
            ],
            "additionalProperties": false
          },
          "maxItems": 16,
          "default": []
        },
        "statusItems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/localId"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "location": {
                "const": "statusBar"
              },
              "scope": {
                "$ref": "#/$defs/scope"
              },
              "commandId": {
                "$ref": "#/$defs/localId"
              },
              "order": {
                "$ref": "#/$defs/order"
              }
            },
            "required": [
              "id",
              "label",
              "location",
              "scope"
            ],
            "additionalProperties": false
          },
          "maxItems": 2,
          "default": []
        }
      },
      "required": [
        "commands",
        "configuration",
        "views"
      ],
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "properties": {
        "provides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
                "not": {
                  "pattern": "^se\\.host\\."
                }
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "maxItems": 32
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "maxItems": 32
        }
      },
      "required": [
        "provides",
        "requires"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "abi",
    "contributes",
    "services"
  ],
  "additionalProperties": false,
  "$comment": "Input is at most 262144 UTF-8 bytes. Runtime additionally validates semver, abi.min <= abi.max, unique same-kind contribution IDs, and same-manifest command references. Empty optional contribution arrays are omitted when serialized. All se.host.* providers are reserved; unknown host requirements remain valid but unresolved.",
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "scope": {
      "enum": [
        "window",
        "activeProject"
      ]
    },
    "order": {
      "type": "integer",
      "minimum": -100,
      "maximum": 100,
      "default": 0
    },
    "when": {
      "type": "object",
      "properties": {
        "project.exists": {
          "type": "boolean"
        },
        "terminal.exists": {
          "type": "boolean"
        },
        "agentSession.exists": {
          "type": "boolean"
        },
        "textInput.focused": {
          "type": "boolean"
        },
        "terminal.focused": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "key": {
      "type": "string",
      "pattern": "^(?:|(?:ctrl(?:\\+cmd)?|cmd)(?:\\+shift)?(?:\\+alt)?\\+(?:[a-z0-9]|f(?:[1-9]|1[0-2])|enter|space|tab|escape|backspace|delete|home|end|pageup|pagedown|arrow(?:up|down|left|right)))$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contributes": {
            "properties": {
              "eventSubscriptions": {
                "minItems": 1
              }
            },
            "required": [
              "eventSubscriptions"
            ]
          }
        },
        "required": [
          "contributes"
        ]
      },
      "then": {
        "properties": {
          "services": {
            "properties": {
              "requires": {
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "se.host.context"
                        },
                        "version": {
                          "const": 1
                        }
                      },
                      "required": [
                        "name",
                        "version"
                      ]
                    }
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "se.host.events"
                        },
                        "version": {
                          "const": 1
                        }
                      },
                      "required": [
                        "name",
                        "version"
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contributes": {
            "properties": {
              "statusItems": {
                "minItems": 1
              }
            },
            "required": [
              "statusItems"
            ]
          }
        },
        "required": [
          "contributes"
        ]
      },
      "then": {
        "properties": {
          "services": {
            "properties": {
              "requires": {
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "se.host.status"
                        },
                        "version": {
                          "const": 1
                        }
                      },
                      "required": [
                        "name",
                        "version"
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
