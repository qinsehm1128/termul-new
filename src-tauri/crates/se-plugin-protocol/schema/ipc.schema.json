{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termul.dev/plugin/v1/ipc.schema.json",
  "$comment": "Named contracts for section 9. Validate using #/$defs/<Type>. Snapshot/event seq may start at zero; revisions are positive. Semantic identities/default completion are checked by runtime.",
  "$defs": {
    "PluginError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "message": {
          "type": "string",
          "minLength": 0,
          "maxLength": 8192
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "PluginInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "manifest": {
          "$ref": "manifest.schema.json"
        },
        "desiredEnabled": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "installed",
            "disabled",
            "pending",
            "activating",
            "active",
            "reloading",
            "failed",
            "quarantined"
          ]
        },
        "generation": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "configRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "lastError": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "message": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 8192
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "manifest",
        "desiredEnabled",
        "state",
        "generation",
        "configRevision",
        "sha256",
        "lastError"
      ],
      "additionalProperties": false
    },
    "PluginSnapshot": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "bootId": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "plugins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginInfo"
          }
        }
      },
      "required": [
        "schemaVersion",
        "bootId",
        "seq",
        "plugins"
      ],
      "additionalProperties": false
    },
    "ViewSnapshot": {
      "type": "object",
      "properties": {
        "pluginId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "configRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tree": {
          "$ref": "ui.schema.json"
        }
      },
      "required": [
        "pluginId",
        "generation",
        "revision",
        "configRevision",
        "tree"
      ],
      "additionalProperties": false
    },
    "ConfigSnapshot": {
      "type": "object",
      "properties": {
        "pluginId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "schema": {
          "$ref": "configuration.schema.json"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "values": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "overrides": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "required": [
        "pluginId",
        "schema",
        "revision",
        "values",
        "overrides"
      ],
      "additionalProperties": false
    },
    "HealthSnapshot": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "bootId": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "ready": {
          "type": "boolean"
        },
        "safeMode": {
          "type": "boolean"
        },
        "activeResources": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schemaVersion",
        "bootId",
        "pid",
        "ready",
        "safeMode",
        "activeResources"
      ],
      "additionalProperties": false
    },
    "PluginEvent": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "bootId": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "enum": [
            "registry_changed",
            "state_changed",
            "view_changed",
            "config_changed",
            "resync_required",
            "host_ui_changed"
          ]
        },
        "pluginId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
        },
        "viewId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "configRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schemaVersion",
        "bootId",
        "seq",
        "type"
      ],
      "additionalProperties": false
    },
    "PluginConnectionEvent": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "connected",
            "disconnected"
          ]
        },
        "bootId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "bootId"
      ],
      "additionalProperties": false
    },
    "ListRequest": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "HealthRequest": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "ShutdownRequest": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "InstallRequest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "SetEnabledRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "enabled"
      ],
      "additionalProperties": false
    },
    "ReloadRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "UninstallRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "UninstallResult": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "removed": {
          "const": true
        }
      },
      "required": [
        "id",
        "removed"
      ],
      "additionalProperties": false
    },
    "GetViewRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "viewId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      },
      "required": [
        "id",
        "viewId"
      ],
      "additionalProperties": false
    },
    "ActionEvent": {
      "$ref": "action.schema.json"
    },
    "ExecuteCommandRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
        },
        "commandId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "args": {}
      },
      "required": [
        "id",
        "generation",
        "commandId",
        "args"
      ],
      "additionalProperties": false
    },
    "GetConfigRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "SetConfigRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "values": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "required": [
        "id",
        "expectedRevision",
        "values"
      ],
      "additionalProperties": false
    },
    "HostContextPublishRequest": {
      "$ref": "host.schema.json#/$defs/HostContextPublishRequest"
    },
    "HostContextHeartbeatRequest": {
      "$ref": "host.schema.json#/$defs/HostContextHeartbeatRequest"
    },
    "HostContextAck": {
      "$ref": "host.schema.json#/$defs/HostContextAck"
    },
    "HostUiGetRequest": {
      "$ref": "host.schema.json#/$defs/HostUiGetRequest"
    },
    "HostUiSnapshot": {
      "$ref": "host.schema.json#/$defs/HostUiSnapshot"
    },
    "HostUiDismissRequest": {
      "$ref": "host.schema.json#/$defs/HostUiDismissRequest"
    },
    "HostUiDismissResult": {
      "$ref": "host.schema.json#/$defs/HostUiDismissResult"
    },
    "ExecuteContributionRequest": {
      "$ref": "host.schema.json#/$defs/ExecuteContributionRequest"
    }
  }
}
