              "enum": [
                "invoke",
                "view.dispatch",
                "config.get",
                "config.set",
                "context.snapshot",
                "storage.get",
                "storage.set",
                "storage.delete",
                "feedback.notification.upsert",
                "feedback.notification.close",
                "feedback.progress.upsert",
                "theme.get"
              ]
            },
            "params": {}
          },
          "required": [
            "channel",
            "version",
            "sessionId",
            "nonce",
            "type",
            "requestId",
            "method",
            "params"
          ]
        },
