{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termul.dev/plugin/v1/config.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "pluginId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "values": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "changedKeys": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "maxItems": 64,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "pluginId",
    "revision",
    "values",
    "changedKeys"
  ],
  "additionalProperties": false,
  "$comment": "Input is at most 262144 UTF-8 bytes. Runtime derives values schema from ConfigurationSchema: all keys must be present, no unknown keys, matching types/enums/bounds; changedKeys must name schema keys."
}
