            "value" : "请在主机设置中启用远程桌面查看。"
          }
        }
      }
    },
    "On the Mac, allow Screen Recording in System Settings → Privacy & Security, then retry." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 Mac 的“系统设置 → 隐私与安全性”中允许屏幕录制，然后重试。"
          }
        }
      }
    },
    "View only: ask the host owner to grant this device screen control permission." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅查看：请主机所有者授予此设备屏幕控制权限。"
          }
        }
      }
    },
    "View only: enable remote mouse and keyboard control on the host." : {
      "localizations" : {
        "zh-Hans" : {
